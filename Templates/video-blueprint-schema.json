{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "video-inspiration-blueprint-v1.0",
  "title": "Video Inspiration Blueprint",
  "description": "Schema for AI-extracted video analysis to enable Remotion recreation",
  "type": "object",
  "required": ["source", "assets", "animations", "snapshots"],
  "additionalProperties": false,

  "properties": {
    "$schema": {
      "type": "string",
      "const": "video-inspiration-blueprint-v1.0"
    },

    "source": {
      "type": "object",
      "required": ["description", "duration", "dimensions", "fps", "background"],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "description": "One-sentence summary of the video content"
        },
        "duration": {
          "type": "number",
          "minimum": 0,
          "description": "Total duration in seconds"
        },
        "dimensions": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          }
        },
        "fps": {
          "type": "integer",
          "enum": [24, 25, 30, 50, 60],
          "description": "Frames per second"
        },
        "background": {
          "type": "string",
          "description": "CSS color, gradient, or 'transparent'"
        }
      }
    },

    "scenes": {
      "type": "array",
      "description": "Timeline segments for Sequence organization",
      "items": {
        "type": "object",
        "required": ["id", "name", "start", "end"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Unique identifier (kebab-case)"
          },
          "name": {
            "type": "string",
            "description": "Human-readable scene name"
          },
          "start": {
            "type": "number",
            "minimum": 0,
            "description": "Start time in seconds"
          },
          "end": {
            "type": "number",
            "minimum": 0,
            "description": "End time in seconds"
          },
          "transition": {
            "type": "string",
            "enum": ["cut", "fade", "slide-left", "slide-right", "slide-up", "slide-down", "zoom", "dissolve"],
            "description": "How this scene enters"
          }
        }
      }
    },

    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "sourceType", "description", "position"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Unique identifier (kebab-case)"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "text-container",
              "image",
              "vector-art",
              "shape",
              "shape-group",
              "video",
              "3d-model",
              "3d-text",
              "lottie",
              "particle-system"
            ]
          },
          "sceneId": {
            "type": "string",
            "description": "Which scene this belongs to (omit if global)"
          },
          "sourceType": {
            "type": "string",
            "enum": ["user-provided", "generate", "built-in"],
            "description": "Where Claude Code should get this asset"
          },
          "description": {
            "type": "string",
            "description": "Visual description of the asset"
          },
          "content": {
            "type": "string",
            "description": "For text assets, the actual text"
          },
          "position": {
            "$ref": "#/definitions/position"
          },
          "style": {
            "type": "object",
            "description": "Visual styling properties",
            "properties": {
              "color": { "type": "string" },
              "backgroundColor": { "type": "string" },
              "borderRadius": { "type": "number" },
              "borderColor": { "type": "string" },
              "borderWidth": { "type": "number" },
              "fontSize": { "type": "number" },
              "fontWeight": { "type": "string" },
              "fontFamily": { "type": "string" },
              "textAlign": { "type": "string", "enum": ["left", "center", "right"] },
              "lineHeight": { "type": "number" },
              "paddingX": { "type": "number" },
              "paddingY": { "type": "number" },
              "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
              "shadow": { "type": "string" },
              "blur": { "type": "number" }
            }
          }
        }
      }
    },

    "layers": {
      "type": "array",
      "description": "Z-ordering of assets",
      "items": {
        "type": "object",
        "required": ["order", "assetId"],
        "additionalProperties": false,
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 0,
            "description": "Stack order (0 = backmost)"
          },
          "assetId": {
            "type": "string",
            "description": "Reference to asset id"
          }
        }
      }
    },

    "animations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "target", "property"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "target": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" } }
            ],
            "description": "Asset id(s) this animation applies to"
          },
          "property": {
            "type": "string",
            "enum": [
              "position.x",
              "position.y",
              "position.z",
              "scale",
              "scale.x",
              "scale.y",
              "rotation",
              "rotation.x",
              "rotation.y",
              "rotation.z",
              "opacity",
              "blur"
            ]
          },
          "description": {
            "type": "string"
          },
          "keyframes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["time", "value"],
              "properties": {
                "time": { "type": "number", "minimum": 0 },
                "value": { "type": "number" },
                "easing": { "$ref": "#/definitions/easing" }
              }
            }
          },
          "easing": {
            "$ref": "#/definitions/easing"
          },
          "motion": {
            "type": "string",
            "enum": ["oscillating", "rotating", "pulsing"]
          },
          "amplitude": {
            "type": "number",
            "description": "Size of continuous motion"
          },
          "period": {
            "type": "number",
            "minimum": 0,
            "description": "Duration of one cycle in seconds"
          },
          "lifespan": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2,
            "description": "[startTime, endTime] when motion is active"
          }
        }
      }
    },

    "snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["time", "description"],
        "additionalProperties": false,
        "properties": {
          "time": {
            "type": "number",
            "minimum": 0,
            "description": "Timestamp in seconds"
          },
          "description": {
            "type": "string",
            "description": "What's visible on screen at this moment"
          }
        }
      }
    },

    "visualNotes": {
      "type": "object",
      "properties": {
        "colorPalette": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Dominant colors (hex values)"
        },
        "atmosphere": {
          "type": "string",
          "description": "Emotional tone"
        },
        "style": {
          "type": "string",
          "description": "Visual style"
        },
        "lighting": {
          "type": "string",
          "description": "Lighting approach"
        },
        "motionCharacter": {
          "type": "string",
          "description": "How things move"
        },
        "typography": {
          "type": "string",
          "description": "Font style observations"
        }
      }
    }
  },

  "definitions": {
    "position": {
      "type": "object",
      "required": ["anchor"],
      "properties": {
        "anchor": {
          "type": "string",
          "enum": [
            "center",
            "top-left",
            "top-center",
            "top-right",
            "center-left",
            "center-right",
            "bottom-left",
            "bottom-center",
            "bottom-right",
            "fullscreen"
          ]
        },
        "x": {
          "type": "number",
          "default": 0,
          "description": "Horizontal offset from anchor in pixels"
        },
        "y": {
          "type": "number",
          "default": 0,
          "description": "Vertical offset from anchor in pixels"
        },
        "z": {
          "type": "number",
          "default": 0,
          "description": "Depth for 3D scenes"
        }
      }
    },
    "easing": {
      "type": "string",
      "enum": [
        "linear",
        "ease-in",
        "ease-out",
        "ease-in-out",
        "ease-out-quad",
        "ease-out-cubic",
        "ease-out-expo",
        "ease-out-back",
        "ease-out-elastic",
        "ease-in-quad",
        "ease-in-cubic",
        "ease-in-expo",
        "ease-in-back",
        "ease-in-elastic",
        "bounce",
        "step-end",
        "step-start"
      ]
    }
  }
}
